# Isabella V6 — local environment template
# Never commit real values. Use Vercel Project Vars / .env.development.local.

# Connected integrations already provisioned in this project
AI_GATEWAY_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
# PostgreSQL connection for the governed pipeline BookPI adapter.
# Runtime prefers DATABASE_URL, then Vercel POSTGRES_URL, then POSTGRES_URL_NON_POOLING.
# Requires infra/db/migrations/001_create_bookpi_events.sql and 002_bookpi_canonical_immutability.sql.
DATABASE_URL=
POSTGRES_PRISMA_URL=
POSTGRES_HOST=
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# Runtime and public URL
# PID reconciliation safety controls (CLI only): bounded timeout and jittered retries.
RECONCILIATION_TIMEOUT_MS=30000
RECONCILIATION_MAX_ATTEMPTS=3
RECONCILIATION_RETRY_BASE_MS=1000
RECONCILIATION_RETRY_MAX_MS=10000
APP_BASE_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
INFERENCE_TIMEOUT_MS=8000
# Whole fallback-chain latency cap per chat reply (6000-60000 ms). Each provider attempt gets min(INFERENCE_TIMEOUT_MS, remaining).
CHAT_CHAIN_BUDGET_MS=20000
PROVIDER_FAILURE_COOLDOWN_MS=60000
ALLOW_PAID_PROVIDER_FALLBACK=false

# Model providers (optional). Configure at least one only after checking its access and pricing.
GEMINI_API_KEY=
MODEL_API_KEY=
OPENROUTER_API_KEY=
# This route accepts openrouter/free or a model ID ending in :free; other model IDs are refused here.
OPENROUTER_FREE_MODEL=openrouter/free
HF_TOKEN=
# Explicit model IDs selected for this account. This API may consume credits or incur charges;
# invocation is blocked unless ALLOW_PAID_PROVIDER_FALLBACK=true.
HF_FREE_MODELS=
# Potentially billable/usage-credit providers. Both ALLOW_PAID_PROVIDER_FALLBACK=true
# and an explicit model ID per configured provider are required before any request is sent.
# Ollama Cloud: model access uses usage credits; see https://ollama.com/pricing.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
TOGETHER_API_KEY=
TOGETHER_MODEL=
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=
FIREWORKS_API_KEY=
FIREWORKS_MODEL=
# Perplexity Router is also potentially billable: key + explicit model + paid opt-in required.
PERPLEXITY_API_KEY=
PERPLEXITY_ROUTER_MODEL=
# Keyless free text provider (operator opt-in; OFF unless enabled). It produces
# REAL generative text WITHOUT any credential so a node can converse before a
# keyed provider is configured. Enabling it forwards the prompt plus up to eight
# history turns to a third-party free endpoint; do NOT enable it for confidential
# data. Set to `pollinations` (or `on`/`true`/`1`) to enable; disclosed as engine
# "keyless-free" and never presented as sovereign inference.
ISABELLA_KEYLESS_FREE_PROVIDER=
KEYLESS_FREE_PROVIDER_URL=https://text.pollinations.ai
KEYLESS_FREE_PROVIDER_MODEL=openai
KEYLESS_FREE_PROVIDER_TIMEOUT_MS=30000
INFERENCE_API_KEY=
INFERENCE_BASE_URL=
INFERENCE_MODEL=
INFERENCE_EMBEDDING_MODEL=
MODEL_ENDPOINT=

# BookPI persistence
# Optional local JSONL ledger for local/dev use only. A local file on Vercel/serverless
# is not a shared multi-instance source of truth and is not WORM storage.
# BOOKPI_LEDGER_PATH=./data/bookpi/ledger.jsonl
# Optional durable JSONL path for the governed pipeline conductor ledger
# (POST /api/v1/pipeline/execute). When unset, the pipeline uses an in-memory
# SHA-256 hash chain (volatile, not durable).
# BOOKPI_PIPELINE_LEDGER_PATH=./data/bookpi/pipeline.jsonl
# Auto-selects PostgreSQL when DATABASE_URL exists; optional explicit values: postgres | jsonl | memory.
# Use postgres for shared multi-instance evidence. JSONL is durable only on a persistent mounted volume.
BOOKPI_PIPELINE_STORAGE=

# Governance, identity and protected APIs
BOOKPI_INTEGRITY_SECRET=
TOKEN_ENCRYPTION_KEY=
HSF_API_TOKEN=
GENESIS_ADMIN_API_TOKEN=
# IGDS-v1 Document Seal: Ed25519 private key (PKCS#8 PEM) used to sign document
# manifests. If unset, an ephemeral in-memory key is generated (not persistent
# across restarts; the public key always travels inside each manifest).
GENESIS_DOCUMENT_SEAL_KEY_PEM=
ISABELLA_APPROVAL_KEY_ID=
ISABELLA_APPROVAL_PRIVATE_KEY_PEM=
ISABELLA_APPROVAL_TRUSTED_KEY_ID=
ISABELLA_APPROVAL_TRUSTED_PUBLIC_KEY_PEM=
ISABELLA_APPROVAL_TRUSTED_APPROVER_ID=
WEBHOOK_SIGNING_SECRET=
CONNECTOR_WEBHOOK_SECRET=
CONNECTOR_PROVIDERS=stripe,github,slack,linear
CONNECTOR_TENANT_MAP=

# Multimodal (image understanding / synthesis) and speech (TTS/STT).
# Each capability is key-driven and fails closed: nothing is attempted without a
# provider credential; model overrides below are optional and provider keys are reused.
# Vision (image -> text): configure any one of these.
OPENROUTER_VISION_MODEL=
GEMINI_VISION_MODEL=
GEMINI_IMAGE_MODEL=
GEMINI_API_BASE=
HF_VISION_MODELS=
HF_IMAGE_MODELS=
NOVITA_VISION_MODEL=
NOVITA_IMAGE_MODEL=
TOGETHER_VISION_MODEL=
TOGETHER_IMAGE_MODEL=
DEEPINFRA_VISION_MODEL=
DEEPINFRA_IMAGE_MODEL=
FIREWORKS_VISION_MODEL=
FIREWORKS_IMAGE_MODEL=
# Local OpenAI-compatible vision/image servers (llama.cpp, vLLM, Ollama).
LOCAL_VISION_BASE_URL=
LOCAL_VISION_MODEL=
LOCAL_VISION_API_KEY=
LOCAL_IMAGE_BASE_URL=
LOCAL_IMAGE_MODEL=
LOCAL_IMAGE_API_KEY=
# Per-request budget for vision/image routes. Local CPU inference can take
# minutes on first (cold) load, so the default ceiling is higher than INFERENCE_TIMEOUT_MS.
MULTIMODAL_TIMEOUT_MS=120000
# Speech (Groq Orpheus TTS + Whisper STT). Requires accepting Groq model terms once.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
GROQ_STT_MODEL=whisper-large-v3

# Observability and optional services
OTEL_EXPORTER_OTLP_ENDPOINT=
PENNYLANE_BRIDGE_URL=
PENNYLANE_BRIDGE_TIMEOUT_MS=5000
PENNYLANE_BACKEND=pennylane-lightning
FIREBASE_API_KEY=
PAYMENT_PROVIDER_SECRET=
# Stripe Billing (server-only; never expose secret values in clients).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Added 2026-10-13 (engine-generated, draft): variables read by the runtime that were undocumented.
NODE_ENV=production
# Process-wide AI Passport registry; durable when set (UAGP-1).
GAMEOVER_PASSPORT_PATH=
# Human approval for POST /api/v1/gameover/govern (both required to authenticate a principal).
GENESIS_HUMAN_APPROVAL_TOKEN=
GENESIS_HUMAN_APPROVER_ID=
# Token for provider-backed public/demo routes in production (Bearer, >=32 chars).
# Required for /api/v1/tools/execute, multimodal/voice routes, and external model selection.
GENESIS_PUBLIC_API_TOKEN=
# HyperCore routes (/api/v1/hypercore/*, /api/v1/mcp).
HYPERCORE_API_TOKEN=
HYPERCORE_SIGNING_KEY=
# Bearer token for GET /api/v1/ops/latency.
OPS_API_TOKEN=
# Kill switch (REINA / ISA-X): "1" or "true" halts every scope (fail-closed).
ISA_KILL_SWITCH=
# Optional "gratis" OpenAI-compatible provider.
GRATIS_API_URL=https://api.gratis.ai/v1
GRATIS_API_KEY=
GRATIS_API_MODEL=gpt-4o-mini
# Local deterministic engine.
ISABELLA_BOT_NAME=
ISABELLA_BOT_VERSION=
ISABELLA_LANGUAGE=
ISABELLA_MAX_RESPONSE_LENGTH=
# Session memory bounds.
SESSION_MEMORY_MAX_MESSAGES=50
SESSION_MEMORY_MAX_SESSIONS=1000
# Set automatically by Vercel / Vitest; do not set by hand.
# VERCEL=
# VERCEL_OIDC_TOKEN=
# VITEST=

# Number of trusted reverse-proxy hops (1..10) so req.ip / rate limits use X-Forwarded-For. Unset = do not trust it.
TRUST_PROXY=

# OpenAI-compatible surface (/v1/models, /v1/chat/completions, /v1/completions).
# Makes Isabella a drop-in model for any OpenAI SDK client. Wire-compatible only;
# every request is mediated by the canonical Genesis runtime and rate-limited.
# Advertised base model id (profiles are derived from the "-<profile>" suffix).
OPENAI_COMPAT_MODEL_ID=isabella-genesis
# Optional Bearer token (>=32 chars). When set, the surface requires it; when
# empty, the surface stays open but rate-limited (public cognition bucket).
OPENAI_COMPAT_API_TOKEN=
# Set to 1 to abort startup when the configuration preflight finds blocking errors (recommended in production).
STRICT_PREFLIGHT=

# --- Perplexity Router API ---
PERPLEXITY_API_KEY=

# --- Braintrust observability ---
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT_ID=

# --- PID reconciliation ---
ORCID_ID=
ZENODO_DOI=
DATACITE_DOI=
ISNI=
PID_STRICT=
PID_NAMESPACE=
